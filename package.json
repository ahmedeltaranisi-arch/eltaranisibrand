{
  "name": "mate-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify": "npm run check:i18n && npm run lint && tsc --noEmit && next build && npm run check:css",
    "check:css": "node scripts/check-css.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
